#!/bin/sh
set -eu
APP=/root/edge_dash.py
HTML=/root/index.html
LOG=/tmp/dashboard.log
PIDFILE=/run/edge-monitor.pid
CONFIG=/etc/default/edge-monitor
SERVICE=edge-monitor.service
PYTHON=$(command -v python3 || echo /usr/bin/python3)

load_config() {
  if [ -r "$CONFIG" ]; then
    # The config file is maintained by the installer and contains shell assignments only.
    set -a
    . "$CONFIG"
    set +a
  fi
}

stop_fallback() {
  if [ -r "$PIDFILE" ]; then
    pid=$(cat "$PIDFILE" 2>/dev/null || true)
    case "$pid" in ''|*[!0-9]*) ;; *) kill "$pid" 2>/dev/null || true ;; esac
    rm -f "$PIDFILE"
  fi
  # Match this exact script name, not every Python process on the machine.
  if command -v pkill >/dev/null 2>&1; then pkill -f '[e]dge_dash.py' 2>/dev/null || true; fi
}

case "${1:-}" in
  bg|start)
    if [ -f "/etc/systemd/system/$SERVICE" ] && command -v systemctl >/dev/null 2>&1; then
      systemctl start "$SERVICE"
      systemctl --no-pager --full status "$SERVICE" | sed -n '1,8p'
    else
      load_config
      if curl -fsS "http://127.0.0.1:${DASH_PORT:-8026}/healthz" >/dev/null 2>&1; then
        echo "Dashboard already responds on port ${DASH_PORT:-8026}."
        exit 0
      fi
      stop_fallback
      nohup "$PYTHON" -u "$APP" >> "$LOG" 2>&1 &
      echo $! > "$PIDFILE"
      sleep 1
      if kill -0 "$(cat "$PIDFILE")" 2>/dev/null; then
        echo "Dashboard started in background (PID $(cat "$PIDFILE")); log: $LOG"
      else
        echo "Dashboard failed to start; last log lines:"
        tail -n 40 "$LOG" || true
        exit 1
      fi
    fi
    ;;
  up)
    if [ -f "/etc/systemd/system/$SERVICE" ] && command -v systemctl >/dev/null 2>&1; then systemctl stop "$SERVICE" || true; fi
    stop_fallback
    load_config
    exec "$PYTHON" -u "$APP"
    ;;
  restart)
    if [ -f "/etc/systemd/system/$SERVICE" ] && command -v systemctl >/dev/null 2>&1; then
      systemctl restart "$SERVICE"
      systemctl --no-pager --full status "$SERVICE" | sed -n '1,8p'
    else
      "$0" down
      "$0" bg
    fi
    ;;
  down|stop)
    if [ -f "/etc/systemd/system/$SERVICE" ] && command -v systemctl >/dev/null 2>&1; then systemctl stop "$SERVICE" || true; fi
    stop_fallback
    echo "Dashboard stopped (only edge_dash.py was targeted)."
    ;;
  logs)
    if [ -f "/etc/systemd/system/$SERVICE" ] && command -v journalctl >/dev/null 2>&1; then
      journalctl -u "$SERVICE" -f
    else
      touch "$LOG"
      tail -F "$LOG"
    fi
    ;;
  status)
    if [ -f "/etc/systemd/system/$SERVICE" ] && command -v systemctl >/dev/null 2>&1; then
      systemctl --no-pager --full status "$SERVICE" || true
    else
      load_config
      if curl -fsS "http://127.0.0.1:${DASH_PORT:-8026}/healthz"; then echo; else echo "Dashboard is not responding."; exit 1; fi
    fi
    ;;
  test)
    load_config
    curl -fsS "http://127.0.0.1:${DASH_PORT:-8026}/healthz"; echo
    ;;
  *)
    echo "Usage: dashboard {up|bg|restart|down|logs|status|test}"
    exit 2
    ;;
esac
